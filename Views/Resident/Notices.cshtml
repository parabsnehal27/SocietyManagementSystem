@model IEnumerable<SocietyManagementSystem.Models.Notice>

@{
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
    ViewData["Title"] = "Society Notices";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #0066CC, #00A8E8);
        color: white;
        padding: 28px;
        border-radius: 20px;
        margin-bottom: 30px;
        box-shadow: 0 10px 25px rgba(0,102,204,.18);
    }

        .page-header h2 {
            margin: 0;
            font-size: 30px;
        }

    .notices-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(320px,1fr));
        gap: 20px;
    }

    .notice-card {
        background: white;
        border-radius: 20px;
        padding: 22px;
        border: 1px solid #D8E9FF;
        box-shadow: 0 8px 20px rgba(0,102,204,.08);
        transition: .3s;
    }

        .notice-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 28px rgba(0,102,204,.14);
        }

    .notice-title {
        font-size: 20px;
        font-weight: 700;
        color: #1A1A2E;
        margin-bottom: 10px;
    }

    .notice-type {
        display: inline-block;
        background: #EAF6FF;
        color: #0066CC;
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .notice-description {
        color: #5B6B8A;
        font-size: 14px;
        line-height: 1.6;
        min-height: 70px;
        margin-bottom: 20px;
    }

    .notice-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .notice-date {
        color: #7A8CA5;
        font-size: 13px;
    }

    .notice-btn {
        display: inline-block;
        text-decoration: none;
        background: linear-gradient(135deg,#0066CC,#00A8E8);
        color: white;
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 600;
    }

        .notice-btn:hover {
            color: white;
        }

    .badge-new {
        background: #FFECEC;
        color: #E74C3C;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-read {
        background: #E8F8EE;
        color: #27AE60;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
    }

    .empty-state {
        background: white;
        padding: 50px;
        text-align: center;
        border-radius: 20px;
    }
</style>

<div class="page-header">
    <h2>Society Notices</h2>
</div>

@if (Model.Any())
{
    <div class="notices-grid">

        @foreach (var notice in Model)
        {
            bool isRead =
            ((List<int>)ViewBag.ReadNotices)
            .Contains(notice.NoticeId);

            <div class="notice-card">

                <div class="notice-title">
                    @notice.Title
                </div>

                <div class="notice-type">
                    @notice.NoticeType
                </div>

                <div class="notice-description">

                    @(notice.Description?.Length > 120
                        ? notice.Description.Substring(0, 120) + "..."
                        : notice.Description)

                </div>

                <div class="notice-footer">

                    @if (isRead)
                    {
                        <span class="badge-read">
                            Read
                        </span>
                    }
                    else
                    {
                        <span class="badge-new">
                            New
                        </span>
                    }

                    <span class="notice-date">
                        @notice.PostedDate.ToString("dd MMM yyyy")
                    </span>

                </div>

                <div class="mt-3">

                    <a asp-action="NoticeDetails"
                       asp-route-id="@notice.NoticeId"
                       class="notice-btn">

                        Read Notice

                    </a>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="empty-state">
        <h3>No Notices Available</h3>
        <p>No notices have been published yet.</p>
    </div>
}