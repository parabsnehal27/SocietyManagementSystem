@model List<SocietyManagementSystem.Models.Complaint>

<h2>My Complaints</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (Model.Count == 0)
{
    <p>No complaints submitted yet.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Submitted On</th>
                <th>Resolution Remarks</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var complaint in Model)
            {
                <tr>
                    <td>@complaint.Title</td>
                    <td>@complaint.Category</td>
                    <td>@complaint.Status</td>
                    <td>@(complaint.Priority ?? "Not Assigned")</td>
                    <td>@complaint.CreatedAt.ToShortDateString()</td>
                    <td>@(complaint.ResolutionRemarks ?? "Pending")</td>
                </tr>
            }
        </tbody>
    </table>
}