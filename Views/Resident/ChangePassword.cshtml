@model SocietyManagementSystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
}

<style>

    .password-container {
        width: 100%;
    }

    .password-header {
        background: linear-gradient(135deg,#0066CC,#00A8E8);
        color: white;
        padding: 30px;
    }

        .password-header h2 {
            margin: 0;
            font-size: 28px;
        }

        .password-header p {
            margin-top: 8px;
            opacity: .9;
        }

    .password-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 22px;
    }

    label {
        font-weight: 600;
        color: #1A1A2E;
        display: block;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        padding: 14px;
        border: 1px solid #d9e7f7;
        border-radius: 12px;
        font-size: 15px;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: #00A8E8;
            outline: none;
            box-shadow: 0 0 0 4px rgba(0,168,232,.15);
        }

    .password-rules {
        background: #f8fcff;
        border: 1px solid #d9e7f7;
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 25px;
    }

        .password-rules h5 {
            margin-bottom: 10px;
            color: #1A1A2E;
        }

        .password-rules ul {
            margin: 0;
            padding-left: 20px;
        }

    .btn-save {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg,#0066CC,#00A8E8);
        border: none;
        border-radius: 14px;
        color: white;
        font-size: 17px;
        font-weight: 600;
        cursor: pointer;
        transition: .3s;
    }

        .btn-save:hover {
            transform: translateY(-2px);
        }

    .validation-summary-errors {
        background: #ffe5e5;
        color: #b30000;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    @@media (max-width:768px) {

        .password-body {
            padding: 20px;
        }

        .password-header {
            padding: 22px;
        }

            .password-header h2 {
                font-size: 24px;
            }
    }

</style>

<div class="password-container">

    <div class="password-header">

        <h2>Change Password</h2>

        <p>
            Update your account password securely.
        </p>

    </div>

    <div class="password-body">

        @Html.ValidationSummary()

        <form asp-action="ChangePassword"
              method="post">

            <div class="form-group">

                <label>
                    Current Password
                </label>

                <div class="password-wrapper">

                    <input asp-for="CurrentPassword"
                           type="password"
                           id="currentPassword"
                           class="form-control password-input"
                           placeholder="Enter current password" />

                    <span class="eye-icon"
                          onclick="togglePassword('currentPassword')">

                        <i class="fas fa-eye"></i>

                    </span>

                </div>

            </div>

            <div class="form-group">

                <label>
                    New Password
                </label>

                <div class="password-wrapper">

                    <input asp-for="NewPassword"
                           type="password"
                           id="newPassword"
                           class="form-control password-input"
                           placeholder="Enter new password" />

                    <span class="eye-icon"
                          onclick="togglePassword('newPassword')">

                        <i class="fas fa-eye"></i>

                    </span>

                </div>

            </div>

            <div class="form-group">

                <label>
                    Confirm Password
                </label>

                <div class="password-wrapper">

                    <input asp-for="ConfirmPassword"
                           type="password"
                           id="confirmPassword"
                           class="form-control password-input"
                           placeholder="Confirm new password" />

                    <span class="eye-icon"
                          onclick="togglePassword('confirmPassword')">

                        <i class="fas fa-eye"></i>

                    </span>

                </div>

            </div>

            <div class="password-rules">

                <h5>Password Requirements</h5>

                <ul>
                    <li>Minimum 6 characters</li>
                    <li>At least 1 alphabet</li>
                    <li>At least 1 number</li>
                    <li>At least 1 special character</li>
                </ul>

            </div>

            <button type="submit"
                    class="btn-save">

                Change Password

            </button>

        </form>

    </div>

</div>


<script>

    function togglePassword(id) {

        var input =
            document.getElementById(id);

        if (input.type === "password")
            input.type = "text";
        else
            input.type = "password";
    }

</script>

<style>
    .password-wrapper {
        position: relative;
    }

    .password-input {
        padding-right: 45px;
    }

    .eye-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #6B7280;
    }
    .page-header {
        background: linear-gradient(135deg,#0066CC,#00A8E8);
        color: white;
        padding: 25px;
        border-radius: 20px;
        margin-bottom: 25px;
    }

        .page-header h3 {
            margin: 0;
            font-weight: 700;
        }

        .page-header p {
            margin: 5px 0 0;
        }

    .password-card {
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
        max-width: 700px;
    }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        height: 48px;
        border-radius: 10px;
    }

    .password-info {
        background: #F8FAFC;
        border: 1px solid #E5E7EB;
        padding: 15px;
        border-radius: 12px;
        margin-top: 15px;
        margin-bottom: 20px;
    }

        .password-info ul {
            margin: 10px 0 0;
            padding-left: 20px;
        }

    .save-btn {
        width: 100%;
        border: none;
        padding: 12px;
        border-radius: 12px;
        background: linear-gradient(135deg,#0066CC,#00A8E8);
        color: white;
        font-weight: 600;
    }

        .save-btn:hover {
            opacity: .95;
        }

    @@media(max-width:768px) {

        .password-card {
            padding: 20px;
        }

        .page-header {
            padding: 20px;
        }
    }

</style>