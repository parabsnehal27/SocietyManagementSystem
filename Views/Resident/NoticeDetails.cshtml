@model SocietyManagementSystem.Models.Notice

@{
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
    ViewData["Title"] = "Notice Details";
}

<style>

    .page-header {
        background: linear-gradient(135deg,#0066CC,#00A8E8);
        color: white;
        padding: 28px;
        border-radius: 20px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(0,102,204,.18);
    }

        .page-header h2 {
            margin: 0;
            font-size: 30px;
        }

    .notice-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #D8E9FF;
        box-shadow: 0 8px 20px rgba(0,102,204,.08);
    }

    .notice-title {
        font-size: 28px;
        font-weight: 700;
        color: #1A1A2E;
        margin-bottom: 15px;
    }

    .notice-meta {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .notice-badge {
        background: #EAF6FF;
        color: #0066CC;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .notice-date {
        color: #7A8CA5;
        font-size: 14px;
    }

    .notice-description {
        color: #4F5D75;
        line-height: 1.9;
        font-size: 15px;
        white-space: pre-line;
        margin-top: 20px;
    }

    .action-buttons {
        margin-top: 30px;
    }

    .btn-custom {
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .notice-btn {
        display: inline-block;
        text-decoration: none;
        background: linear-gradient(135deg,#0066CC,#00A8E8);
        color: white;
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 600;
    }

        .notice-btn:hover {
            color: white;
        }
</style>

<div class="page-header">
    <h2>Notice Details</h2>
</div>

<div class="notice-card">

    <div class="notice-title">
        @Model.Title
    </div>

    <div class="notice-meta">

        <span class="notice-badge">
            @Model.NoticeType
        </span>

        <span class="notice-date">
            Posted:
            @Model.PostedDate.ToString("dd MMM yyyy")
        </span>

        @if (Model.ExpiryDate != null)
        {
            <span class="notice-date">
                Expires:
                @Model.ExpiryDate?.ToString("dd MMM yyyy")
            </span>
        }

    </div>

    <hr />

    <div class="notice-description">
        @Model.Description
    </div>

    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
    {
        <div class="action-buttons">

            <a href="@Model.AttachmentPath"
               target="_blank"
               class="btn btn-success btn-custom">

                Download Attachment

            </a>

        </div>
    }

    <div class="action-buttons">

        <a asp-action="Notices"
           class="notice-btn">

            Back to Notices

        </a>

    </div>

</div>