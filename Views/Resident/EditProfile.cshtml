@model SocietyManagementSystem.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
}

<div class="edit-profile-container">

    <div class="page-header">
        <div>
            <h1>Edit Profile</h1>
        </div>
    </div>

    <div class="profile-card">

        <form asp-action="EditProfile" method="post">

            <div class="form-group">
                <label>Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Vehicle Number</label>
                <input asp-for="VehicleNumber" class="form-control" />
            </div>

            <div class="form-group">
                <label>Family Members Count</label>
                <input asp-for="FamilyMembersCount" class="form-control" />
            </div>

            <div class="button-group">

                <button type="submit" class="save-btn">
                    <i class="fas fa-save"></i>
                    Save Changes
                </button>

                <a asp-action="Profile"
                   asp-controller="Resident"
                   class="cancel-btn">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>

    .edit-profile-container {
        width:100%;
    }

    .page-header {
        background: linear-gradient(135deg,#0066CC,#00A8E8);
        color: white;
        padding: 24px;
        border-radius: 20px;
        margin-bottom: 24px;
    }

        .page-header h1 {
            margin: 0;
        }

        .page-header p {
            margin-top: 8px;
            opacity: .9;
        }

    .profile-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #334155;
        }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #CBD5E1;
        border-radius: 12px;
        font-size: 15px;
    }

        .form-control:focus {
            outline: none;
            border-color: #00A8E8;
        }

    .button-group {
        margin-top: 25px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .save-btn {
        border: none;
        background: #00A8E8;
        color: white;
        padding: 12px 20px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 600;
    }

    .cancel-btn {
        text-decoration: none;
        background: #E2E8F0;
        color: #334155;
        padding: 12px 20px;
        border-radius: 12px;
        font-weight: 600;
    }

    .success-alert {
        background: #DCFCE7;
        color: #15803D;
        padding: 14px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .text-danger {
        color: #DC2626;
        font-size: 14px;
    }

    @@media(max - width:768px) {
        .edit-profile-container

    {
        padding: 16px;
    }

    .profile-card {
        padding: 20px;
    }

    .button-group {
        flex-direction: column;
    }

    .save-btn,
    .cancel-btn {
        width: 100%;
        text-align: center;
    }

    }
</style>