@model List<SocietyManagementSystem.Models.Maintenance>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 1;
}

<h2 class="mb-4">Maintenance</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<a href="/Maintenance/Create"
   class="btn btn-primary mb-3">

    Add Maintenance

</a>

<table class="table table-bordered table-striped table-hover">

    <thead class="table-dark">

        <tr>
            <th>#</th>
            <th>Month</th>
            <th>Year</th>
            <th>Amount</th>
            <th>Due Date</th>
            <th>Status</th>
            <th>Paid Date</th>
            <th width="180">Actions</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@count</td>

                <td>@item.Month</td>

                <td>@item.Year</td>

                <td>₹ @item.Amount</td>

                <td>
                    @item.DueDate.ToString("dd-MM-yyyy")
                </td>

                <!-- STATUS -->
                <td>

                    @if (item.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Unpaid
                        </span>
                    }

                </td>

                <!-- PAID DATE -->
                <td>

                    @if (item.PaidDate != null)
                    {
                        @(item.PaidDate?.ToString("dd-MM-yyyy"))
                    }
                    else
                    {
                        <span>-</span>
                    }

                </td>

                <!-- ACTIONS -->
                <td>

                    @if (item.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }

                    <a href="/Maintenance/Delete/@item.MaintenanceId"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Delete maintenance?')">

                        Delete

                    </a>

                </td>

            </tr>

            count++;
        }

    </tbody>

</table>