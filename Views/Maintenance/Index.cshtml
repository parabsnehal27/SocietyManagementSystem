@model List<SocietyManagementSystem.Models.Maintenance>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 1;
}

<h2 class="mb-4">Maintenance</h2>



<div class="d-flex justify-content-between mb-4">

    <a href="/Maintenance/Create"
       class="btn btn-primary">

        Add Maintenance

    </a>

    <div>

        <a href="/Maintenance/ExportPdf"
           class="btn btn-danger">

            Export PDF

        </a>

        <a href="/Maintenance/ExportExcel"
           class="btn btn-success">

            Export Excel

        </a>

    </div>

</div>

<form method="get"
      class="mb-4">

    <div class="input-group w-50">

        <input type="text"
               name="search"
               class="form-control"
               placeholder="Search by Month, Year, Status or Amount" />

        <button class="btn btn-primary">

            <i class="fas fa-search"></i>

            Search

        </button>

    </div>

    <small class="text-muted">

        Search using:
        Month,
        Year,
        Paid/Unpaid Status,
        or Amount

    </small>

</form>

<div class="table-responsive">
<table class="table table-bordered table-striped table-hover">

    <thead class="table-dark">

        <tr>
            <th>#</th>
            <th>Month</th>
            <th>Year</th>
            <th>Amount</th>
            <th>Due Date</th>
            <th>Status</th>
            <th>Paid Date</th>
            <th>Remarks</th>
            <th width="180">Actions</th>
            
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@count</td>

                <td>@item.Month</td>

                <td>@item.Year</td>

                <td>₹ @item.Amount</td>

                <td>
                    @item.DueDate.ToString("dd-MM-yyyy")
                </td>

                <!-- STATUS -->
                <td>

                    @if (item.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Unpaid
                        </span>
                    }

                </td>

                <!-- PAID DATE -->
                <td>

                    @if (item.PaidDate != null)
                    {
                        @(item.PaidDate?.ToString("dd-MM-yyyy"))
                    }
                    else
                    {
                        <span>-</span>
                    }

                </td>
            <td>
                @(string.IsNullOrEmpty(item.Remarks)
                                ? "-"
                                : item.Remarks)
            </td>

                <!-- ACTIONS -->
                <td>

                @if (item.PaymentStatus != "Paid")
                    {
                        <a href="/Maintenance/MarkPaid/@item.MaintenanceId"
                           class="btn btn-warning btn-sm">

                            Mark Paid

                        </a>
                    }

                    <a href="/Maintenance/Delete/@item.MaintenanceId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete maintenance?')">

                        Delete

                    </a>

                </td>

            </tr>

            count++;
        }

    </tbody>
        <tbody>

            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    // existing rows
                }
            }
            else
            {
                <tr>

                    <td colspan="10"
                        class="text-center text-muted">

                        No records found

                    </td>

                </tr>
            }

        </tbody>

</table>
</div>