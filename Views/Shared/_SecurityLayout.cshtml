<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Security Panel</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: #F0FDFA;
            color: #0F172A;
            overflow-x: hidden;
        }

        /* SIDEBAR */
        .sidebar {
            width: 72px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #F8FAFC;
            border-right: 1px solid #CBD5E1;
            padding: 14px 10px;
            transition: width 0.3s ease;
            z-index: 1000;
            overflow: hidden;
        }

            .sidebar.expanded {
                width: 240px;
            }

        /* LOGO */
        .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 60px;
            margin-bottom: 20px;
            color: #0F766E;
            font-weight: 700;
            font-size: 18px;
        }

        .logo-text {
            display: none;
            margin-left: 10px;
        }

        .sidebar.expanded .logo-text {
            display: inline;
        }

        /* MENU LINKS */
        .sidebar a {
            display: flex;
            align-items: center;
            height: 52px;
            padding: 0 16px;
            margin-bottom: 12px;
            border-radius: 14px;
            text-decoration: none;
            color: #0F172A;
            transition: 0.3s;
        }

            .sidebar a:hover {
                background: #E2E8F0;
            }

        /* ICONS */
        .sidebar i {
            font-size: 20px;
            min-width: 28px;
            color: #0F766E;
        }

        /* TEXT HIDDEN BY DEFAULT */
        .sidebar a span {
            display: none;
            margin-left: 12px;
            white-space: nowrap;
            font-weight: 500;
        }

        /* SHOW TEXT ONLY WHEN EXPANDED */
        .sidebar.expanded a span {
            display: inline;
        }

        /* TOPBAR */
        .topbar {
            height: 70px;
            background: #FFFFFF;
            border-bottom: 1px solid #CBD5E1;
            position: fixed;
            top: 0;
            left: 72px;
            width: calc(100% - 72px);
            display: flex;
            align-items: center;
            padding: 0 25px;
            transition: all 0.3s ease;
            z-index: 999;
        }

            .topbar.expanded {
                left: 240px;
                width: calc(100% - 240px);
            }

        /* CONTENT */
        .content {
            margin-left: 72px;
            margin-top: 70px;
            width: calc(100% - 72px);
            padding: 25px;
            background: #F0FDFA;
            min-height: 100vh;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

            .content.expanded {
                margin-left: 240px;
                width: calc(100% - 240px);
            }

        .menu-btn {
            font-size: 30px;
            cursor: pointer;
            color: #0F766E;
        }
    </style>
</head>
<body>

    <div class="sidebar" id="sidebar">
        <a href="javascript:void(0);" onclick="toggleSidebar()" class="menu-link">
            <i class="bi bi-list"></i>
            <span>Menu</span>
        </a>
        <a href="/Security/Dashboard">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>

        <a href="/Security/AddVisitorEntry">
            <i class="bi bi-person-plus"></i>
            <span>Add Visitor</span>
        </a>

        <a href="/Security/VisitorLogs">
            <i class="bi bi-journal-text"></i>
            <span>Visitor Logs</span>
        </a>

        <a href="/Account/Logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
        </a>
    </div>

    <div class="topbar" id="topbar">
        
        <div class="topbar-title">Security Dashboard</div>
    </div>

    <div class="content" id="content">
        @RenderBody()
    </div>
    <script>
        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("expanded");
            document.getElementById("topbar").classList.toggle("expanded");
            document.getElementById("content").classList.toggle("expanded");
        }
    </script>

</body>
</html>