@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <title>@ViewData["Title"] - Security Panel</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            background: #F3FFF6;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 85px;
            left: 0;
            background: linear-gradient(180deg, #0B8F3A, #22C55E);
            color: white;
            transition: 0.3s ease;
            overflow: hidden;
            position: fixed;
            height: 100%;
            z-index: 2000;
            box-shadow: 4px 0 18px rgba(0,0,0,0.08);
        }

            .sidebar.expanded {
                width: 260px;
            }

        .sidebar-header {
            padding: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-bottom: 1px solid rgba(255,255,255,0.15);
        }

        .toggle-btn {
            font-size: 24px;
            cursor: pointer;
            color: white;
        }

        .menu {
            list-style: none;
            padding: 20px 0;
        }

            .menu li {
                margin: 10px 0;
            }

            .menu a {
                color: white;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 18px;
                padding: 15px 24px;
                transition: 0.3s;
                border-radius: 18px;
                margin: 0 10px;
                position: relative;
            }

                .menu a:hover {
                    background: rgba(255,255,255,0.18);
                    transform: translateX(3px);
                }

                .menu a.active {
                    background: rgba(255,255,255,0.22);
                    box-shadow: 0 6px 16px rgba(255,255,255,0.08);
                }

            .menu i {
                font-size: 22px;
                min-width: 24px;
                text-align: center;
            }

            .menu span {
                opacity: 0;
                visibility: hidden;
                transition: 0.2s;
                white-space: nowrap;
                font-size: 16px;
                font-weight: 600;
            }

        .sidebar.expanded .menu span {
            opacity: 1;
            visibility: visible;
        }

        /* MAIN CONTENT */

        .main-content {
            flex: 1;
            margin-left: 85px;
            transition: 0.3s ease;
        }

            .main-content.expanded {
                margin-left: 260px;
            }

        /* TOPBAR */

        .topbar {
            height: 80px;
            background: white;
            box-shadow: 0 3px 20px rgba(0,0,0,0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 1500;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 18px;
        }

            .topbar-left i {
                font-size: 26px;
                color: #16A34A;
                cursor: pointer;
            }

        .panel-title {
            color: #0F172A;
            font-size: 26px;
            font-weight: 800;
            white-space: nowrap;
            margin: 0;
        }

        .user-box {
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .user-box i {
                font-size: 22px;
                color: #16A34A;
            }

            .user-box span {
                color: #0F172A;
                font-size: 18px;
                font-weight: 600;
            }

        /* PAGE CONTENT */

        .page-content {
            padding: 30px;
        }

        /* MOBILE */

        @@media (max-width: 768px) {

            .sidebar {
                width: 260px;
                left: -260px;
            }

                .sidebar.expanded {
                    left: 0;
                }

            .sidebar-header {
                display: none;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

                .main-content.expanded {
                    margin-left: 0;
                }

            .topbar {
                padding: 0 16px;
                height: 72px;
            }

            .panel-title {
                font-size: 18px;
            }

            .user-box span {
                display: none;
            }

            .page-content {
                padding: 16px;
            }
        }

        @@media (max-width: 480px) {

            .user-box .fa-bell {
                display: none;
            }

            .panel-title {
                font-size: 16px;
            }
        }

    </style>

</head>

<body>

    <div class="layout">

        <!-- SIDEBAR -->

        <div class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <i class="fas fa-bars toggle-btn" onclick="toggleSidebar()"></i>
            </div>

            <ul class="menu">

                <li>
                    <a asp-controller="Security"
                       asp-action="Dashboard"
                       class="@(currentAction == "Dashboard" ? "active" : "")">

                        <i class="fas fa-gauge"></i>
                        <span>Dashboard</span>

                    </a>
                </li>

                <li>
                    <a asp-controller="Security"
                       asp-action="AddVisitorEntry"
                       class="@(currentAction == "AddVisitorEntry" ? "active" : "")">

                        <i class="fas fa-user-plus"></i>
                        <span>Add Visitor</span>

                    </a>

                </li>

                <li>
                    <a asp-controller="Security"
                       asp-action="VisitorLogs"
                       class="@(currentAction == "VisitorLogs" ? "active" : "")">

                        <i class="fas fa-clipboard-list"></i>
                        <span>Visitor Logs</span>

                    </a>
                </li>
                <li>
                    <a asp-controller="Security"
                       asp-action="Profile"
                       class="@(currentAction == "Profile" ? "active" : "")">

                        <i class="fas fa-user"></i>
                        <span>Profile</span>

                    </a>
                </li>
                <li>
                    <a asp-controller="Account"
                       asp-action="Logout">

                        <i class="fas fa-right-from-bracket"></i>
                        <span>Logout</span>

                    </a>
                </li>

            </ul>

        </div>

        <!-- MAIN CONTENT -->

        <div class="main-content" id="mainContent">

            <!-- TOPBAR -->

            <div class="topbar">

                <div class="topbar-left">

                    <i class="fas fa-bars"
                       onclick="toggleSidebar()"></i>

                    <h2 class="panel-title">
                        Security Panel
                    </h2>

                </div>

                <div class="user-box">

                    <i class="fas fa-bell"></i>

                    <i class="fas fa-user-circle"></i>

                    <span>
                        @Context.Session.GetString("UserName")
                    </span>

                </div>

            </div>

            <!-- PAGE CONTENT -->

            <div class="page-content">

                @RenderBody()

            </div>

        </div>

    </div>

    <script>

        function toggleSidebar() {

            document
                .getElementById("sidebar")
                .classList
                .toggle("expanded");

            document
                .getElementById("mainContent")
                .classList
                .toggle("expanded");
        }

    </script>

</body>
</html>