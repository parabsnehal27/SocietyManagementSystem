<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Security Panel</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: #F0FDFA;
            color: #0F172A;
            overflow-x: hidden;
        }

        .sidebar {
            width: 80px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #FFFFFF;
            border-right: 1px solid #D1FAE5;
            padding: 20px;
            transition: all 0.3s ease;
            z-index: 1000;
        }

            .sidebar.collapsed {
                width: 80px;
            }

            .sidebar .logo {
                font-size: 24px;
                font-weight: bold;
                margin-bottom: 30px;
                white-space: nowrap;
            }

            .sidebar.collapsed .logo-text {
                display: none;
            }

            .sidebar a {
                display: flex;
                align-items: center;
                gap: 12px;
                color: #F8FAFC;
                text-decoration: none;
                padding: 14px;
                margin-bottom: 10px;
                border-radius: 12px;
                transition: 0.3s;
                white-space: nowrap;
            }

                .sidebar a:hover {
                    background: #F0FDFA;
                    color: #0F766E;
                }

            .sidebar.collapsed a span {
                display: none;
            }

            .sidebar i {
                font-size: 22px;
                color: #0F766E;
            }

        .topbar {
            height: 70px;
            background: #FFFFFF;
            border-bottom: 1px solid #D1FAE5;
            color: #0F172A; 
            display: flex;
            align-items: center;
            padding: 0 25px;
            position: fixed;
            top: 0;
            left: 80px;
            width: calc(100% - 80px);
            transition: all 0.3s ease;
            z-index: 999;
        }

            .topbar.expanded {
                left: 260px;
                width: calc(100% - 260px);
            }

            .topbar.collapsed {
                left: 80px;
            }

        .menu-btn {
            font-size: 28px;
            cursor: pointer;
            color: #0F766E;
        }

        .topbar-title {
            margin-left: 20px;
            font-size: 24px;
            font-weight: 600;
        }

        .content {
            margin-left: 80px;
            background: #F0FDFA;
            margin-top: 70px;
            width: calc(100% - 80px);
            padding: 30px;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

            .content.expanded {
                margin-left: 260px;
                width: calc(100% - 260px);
            }
    </style>
</head>
<body>

    <div class="sidebar collapsed" id="sidebar">
        <a href="/Security/Dashboard">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>

        <a href="/Security/AddVisitorEntry">
            <i class="bi bi-person-plus"></i>
            <span>Add Visitor</span>
        </a>

        <a href="/Security/VisitorLogs">
            <i class="bi bi-journal-text"></i>
            <span>Visitor Logs</span>
        </a>

        <a href="/Security/VisitorLogs">
            <i class="bi bi-shield-check"></i>
            <span>Approvals</span>
        </a>

        <a href="/Account/Logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
        </a>
    </div>

    <div class="topbar" id="topbar">
        <div class="menu-btn" onclick="toggleSidebar()">☰</div>
        <div class="topbar-title">Security Dashboard</div>
    </div>

    <div class="content" id="content">
        @RenderBody()
    </div>

    <script>
        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("collapsed");
            document.getElementById("topbar").classList.toggle("expanded");
            document.getElementById("content").classList.toggle("expanded");
        }
    </script>

</body>
</html>