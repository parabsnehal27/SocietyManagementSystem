@model SocietyManagementSystem.Models.Complaint

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4">Add Complaint</h2>

<form method="post">
    <div class="mb-3">

        <label class="form-label">

            Select Resident

        </label>

        <select asp-for="ResidentId"
                class="form-control"
                asp-items="ViewBag.Residents">

            <option value="">

                -- Select Resident --

            </option>

        </select>

    </div>
    <div class="mb-3">

        <label>Complaint Title</label>

        <input asp-for="Title"
               class="form-control"
               required />

    </div>

    <div class="mb-3">

        <label>Description</label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"
                  required></textarea>

    </div>

    <div class="mb-3">

        <label>Category</label>

        <select asp-for="Category"
                class="form-control"
                required>

            <option value="">-- Select --</option>

            <option>Water</option>
            <option>Electricity</option>
            <option>Parking</option>
            <option>Security</option>
            <option>Lift</option>
            <option>Cleaning</option>

        </select>

    </div>

    <div class="mb-3">

        <label>Priority</label>

        <select asp-for="Priority"
                class="form-control"
                required>

            <option value="">-- Select --</option>

            <option>Low</option>
            <option>Medium</option>
            <option>High</option>

        </select>

    </div>

    <button class="btn btn-success">
        Save Complaint
    </button>

</form>