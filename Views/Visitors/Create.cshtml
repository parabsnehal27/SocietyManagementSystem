@model SocietyManagementSystem.Models.Visitor

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4">Add Visitor</h2>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form method="post" novalidate="false">
    <div class="mb-3">

        <label class="form-label">

            Select Resident

        </label>

        <select asp-for="ResidentId"
                class="form-control"
                asp-items="ViewBag.Residents">

            <option value="">

                -- Select Resident --

            </option>

        </select>

    </div>
    <div class="mb-3">

        <label>Visitor Name</label>

        <input asp-for="VisitorName"
               class="form-control"
               required />

    </div>

    <div class="mb-3">

        <label>Phone Number</label>

        <input asp-for="PhoneNumber"
               type="tel"
               pattern="[0-9]{10}"
               maxlength="10"
               class="form-control"
               required />

    </div>

    <div class="mb-3">

        <label>Purpose</label>

        <textarea asp-for="Purpose"
                  class="form-control"
                  rows="3"
                  required></textarea>

    </div>

    <div class="mb-3">

        <label>Vehicle Number</label>

        <input asp-for="VehicleNumber"
               class="form-control"
               maxlength="10"
               pattern="[A-Z]{2}[0-9]{2}[A-Z]{2}[0-9]{4}"
               style="text-transform:uppercase"
               oninput="this.value=this.value.toUpperCase()" />

        <small class="text-muted">
            Example: MH12AB1234
        </small>

    </div>


    
    <div class="mb-3">

        <label>ID Proof Type</label>

        <select asp-for="IDProofType"
                id="idType"
                class="form-control"
                required>

            <option value="">-- Select --</option>

            <option>Aadhar Card</option>
            <option>PAN Card</option>
            <option>Driving License</option>
            <option>Passport</option>

        </select>

    </div>

    <div class="mb-3">

        <label>ID Proof Number</label>

        <input asp-for="IDProofNumber"
               id="idProofInput"
               class="form-control"
               required />

        <small class="text-muted" id="idHint">
            Enter valid ID proof number
        </small>

    </div>

    <button class="btn btn-success">
        Save Visitor
    </button>

</form>

<script>

    const idType =
        document.getElementById("idType");

    const idInput =
        document.getElementById("idProofInput");

    const hint =
        document.getElementById("idHint");

    idType.addEventListener("change", function () {

        const value = this.value;

        idInput.value = "";

        if (value === "Aadhar Card")
        {
            idInput.pattern = "[0-9]{12}";
            idInput.maxLength = 12;

            hint.innerText =
                "Enter 12 digit Aadhar number";
        }

        else if (value === "PAN Card")
        {
            idInput.pattern =
                "[A-Z]{5}[0-9]{4}[A-Z]{1}";

            idInput.maxLength = 10;

            hint.innerText =
                "Example: ABCDE1234F";
        }

        else if (value === "Driving License")
        {
            idInput.pattern =
                "[A-Z0-9]{8,18}";

            idInput.maxLength = 18;

            hint.innerText =
                "Enter valid license number";
        }

        else if (value === "Passport")
        {
            idInput.pattern =
                "[A-Z][0-9]{7}";

            idInput.maxLength = 8;

            hint.innerText =
                "Example: A1234567";
        }

    });

    // AUTO UPPERCASE
    idInput.addEventListener("input", function () {

        this.value =
            this.value.toUpperCase();

    });

</script>