@model SocietyManagementSystem.Models.Visitor

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body">

<h2 class="mb-4">Add Visitor</h2>


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form method="post" novalidate="false">
    <div class="row">
    <div class="col-md-6 mb-3">

        <label class="form-label">

            Select Resident

        </label>

        <select asp-for="ResidentId"
                class="form-control"
                asp-items="ViewBag.Residents">

            <option value="">

                -- Select Resident --

            </option>

        </select>
        </div>
    </div>

    <div class="row">
    <div class="col-md-6 mb-3">

        <label>Visitor Name</label>

        <input asp-for="VisitorName"
               class="form-control"
               required />
    </div>
    </div>

    <div class="row">
    <div class="col-md-6 mb-3">

        <label>Phone Number</label>

        <input asp-for="PhoneNumber"
               type="tel"
               pattern="[0-9]{10}"
               maxlength="10"
               class="form-control"
               required />
    </div>
    </div>

    <div class="row">
    <div class="col-md-6 mb-3">

        <label>Purpose</label>

        <textarea asp-for="Purpose"
                  class="form-control"
                  rows="3"
                  required ></textarea>
    </div>
    </div>

    <div class="row">
    <div class="col-md-6 mb-3">

        <label>Vehicle Number</label>

        <input asp-for="VehicleNumber"
               class="form-control"
               maxlength="10"
               pattern="[A-Z]{2}[0-9]{2}[A-Z]{2}[0-9]{4}"
               style="text-transform:uppercase"
               oninput="this.value=this.value.toUpperCase()" />

        <small class="text-muted">
            Example: MH12AB1234
        </small>
        </div>
    </div>

    <button class="btn btn-success">
        Save Visitor
    </button>

</form>
            </div>
        </div>

    </div>
</div>
