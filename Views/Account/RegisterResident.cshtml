@model SocietyManagementSystem.ViewModels.RegisterResidentViewModel

@{
    Layout = null;
    ViewData["Title"] = "Resident Registration";
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Resident Registration</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
   
    <style>

        body {
            background: #F3F8FF;
            font-family: 'Segoe UI', sans-serif;
        }

        .register-container {
            max-width: 1000px;
            width: 100%;
            margin: 30px auto;
        }

        .page-header {
            background: linear-gradient(135deg,#0066CC,#00A8E8);
            color: white;
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 25px;
            box-shadow: 0 10px 25px rgba(0,102,204,.18);
        }

            .page-header h2 {
                margin: 0;
                font-size: 32px;
                font-weight: 700;
            }

            .page-header p {
                margin-top: 8px;
                margin-bottom: 0;
                opacity: .95;
            }

        .register-card {
            background: white;
            border-radius: 20px;
            padding: 35px;
            border: 1px solid #D8E9FF;
            box-shadow: 0 8px 20px rgba(0,102,204,.08);
        }

        .section-title {
            color: #0066CC;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 600;
            color: #1A1A2E;
            margin-bottom: 6px;
        }

        .form-control {
            height: 50px;
            border-radius: 12px;
            border: 1px solid #D8E9FF;
        }

        .form-select {
            height: 50px !important;
            border-radius: 12px;
            border: 1px solid #D8E9FF;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #00A8E8;
                box-shadow: none;
            }

        .text-danger {
            font-size: 13px;
            display: block;
            margin-top: 4px;
        }

        .btn-register {
            background: linear-gradient(135deg,#0066CC,#00A8E8);
            color: white;
            border: none;
            width: 100%;
            height: 52px;
            border-radius: 12px;
            font-weight: 600;
            margin-top: 15px;
            font-size: 16px;
        }

            .btn-register:hover {
                color: white;
                opacity: .95;
            }

        .login-link {
            text-align: center;
            margin-top: 20px;
        }

            .login-link a {
                text-decoration: none;
                color: #0066CC;
                font-weight: 600;
            }

        select {
            appearance: auto !important;
            -webkit-appearance: menulist !important;
        }
        @@media (max-width: 768px) {
            .register-container

        {
            margin: 10px;
        }

        .register-card {
            padding: 20px;
        }

        .page-header {
            padding: 20px;
        }

            .page-header h2 {
                font-size: 24px;
            }

            .page-header p {
                font-size: 14px;
            }

        .section-title {
            font-size: 18px;
        }

        .form-control,
        .form-select {
            height: 46px;
        }

        .btn-register {
            height: 48px;
        }

        }

    </style>

</head>

<body>

    <div class="container">

        <div class="register-container">

            <div class="page-header">

                <h2>Resident Registration</h2>

                <p>
                    Create your society resident account
                </p>

            </div>

            <div class="register-card">

                <form asp-action="RegisterResident"
                      method="post">

                    <!-- PERSONAL INFORMATION -->

                    <h4 class="section-title">
                        Personal Information
                    </h4>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control" />

                            <span asp-validation-for="FullName"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Phone Number
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Password
                            </label>

                            <div class="input-group">
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       id="password" />

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        onclick="togglePassword()">

                                    👁

                                </button>
                            </div>
                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label class="form-label">
                                Confirm Password
                            </label>

                            <div class="input-group">
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control"
                                       id="confirmPassword" />

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        onclick="toggleConfirmPassword()">

                                    👁

                                </button>
                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <!-- RESIDENCE INFORMATION -->

                    <h4 class="section-title">
                        Residence Information
                    </h4>

                    <div class="row">
                        <div class="col-md-6 mb-3">

                            <label class="form-label" >
                                Wing
                            </label>

                            <select asp-for="Wing"
                                    id="Wing"
                                    class="form-control">

                                <option value="">
                                    Select Wing
                                </option>

                                <option value="A">Wing A</option>
                                <option value="B">Wing B</option>
                                <option value="C">Wing C</option>
                                <option value="D">Wing D</option>

                            </select>

                            <span asp-validation-for="Wing"
                                  class="text-danger"></span>

                        </div>
                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Floor Number
                            </label>

                            <<select asp-for="FloorNumber"
                                     id="FloorNumber"
                                     class="form-control">

                                <option value="">Select Floor</option>

                                @for (int i = 0; i <= 20; i++)
                                {
                                    <option value="@i">
                                        @i
                                    </option>
                                }

                            </select>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Flat Number
                            </label>

                            <select asp-for="FlatNumber"
                                    id="FlatNumber"
                                    class="form-control">

                                <option value="">
                                    Select Flat
                                </option>

                            </select>

                            <span asp-validation-for="FlatNumber"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Owner / Tenant
                            </label>

                            <select asp-for="OwnerOrTenant"
                                    class="form-select">

                                <option value="">
                                    Select
                                </option>

                                <option>
                                    Owner
                                </option>

                                <option>
                                    Tenant
                                </option>

                            </select>

                            <span asp-validation-for="OwnerOrTenant"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Family Members Count
                            </label>

                            <input asp-for="FamilyMembersCount"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Vehicle Number
                            </label>

                            <input asp-for="VehicleNumber"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Emergency Contact Phone
                            </label>

                            <input asp-for="ContactPhone"
                                   class="form-control" />

                            <span asp-validation-for="ContactPhone"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Move In Date
                            </label>

                            <input asp-for="MoveInDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="MoveInDate"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <button type="submit"
                            class="btn-register">

                        Register Account

                    </button>

                    <div class="login-link">

                        Already have an account?

                        <a asp-action="Login">
                            Login Here
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>

<script>

    function togglePassword() {

        var x =
            document.getElementById("password");

        if (x.type === "password")
            x.type = "text";
        else
            x.type = "password";
    }

    function toggleConfirmPassword() {

        var x =
            document.getElementById("confirmPassword");

        if (x.type === "password")
            x.type = "text";
        else
            x.type = "password";
    }

</script>

<script>

    function loadFlats() {

        let wing =
            document.getElementById("Wing").value;

        let floor =
            parseInt(
                document.getElementById("FloorNumber").value);

        let flatDropdown =
            document.getElementById("FlatNumber");

        flatDropdown.innerHTML =
            '<option value="">Select Flat</option>';

        if (!wing || isNaN(floor))
            return;

        let start = floor * 1000 + 1;

        for (let i = 0; i < 8; i++)
        {
            let flatNumber = start + i;

            flatDropdown.innerHTML +=
                `<option value="${flatNumber}">
                    ${wing}-${flatNumber}
                 </option>`;
        }
    }

    document
        .getElementById("Wing")
        .addEventListener("change", loadFlats);

    document
        .getElementById("FloorNumber")
        .addEventListener("change", loadFlats);

</script>