@model SocietyManagementSystem.Models.Notice

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body">

<h2 class="mb-4">Update Notice</h2>

<form method="post" >
    <input type="hidden"
           asp-for="NoticeId" />
    <input type="hidden"
           asp-for="PostedBy" />

    <input type="hidden"
           asp-for="PostedDate" />


    <div class="mb-3">

        <label>Notice Title</label>

        <input asp-for="Title"
               class="form-control"
               required />

    </div>

    <div class="mb-3">

        <label>Description</label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"
                  required></textarea>

    </div>

    <div class="mb-3">

        <label>Notice Type</label>

        <select asp-for="NoticeType"
                class="form-control"
                required>

            <option value="">-- Select --</option>

            <option>General</option>
            <option>Emergency</option>
            <option>Maintenance</option>
            <option>Event</option>

        </select>

    </div>

    <div class="mb-3">

        <label>Expiry Date</label>

        <input asp-for="ExpiryDate"
               type="date"
               class="form-control"
               min="@DateTime.Now.ToString("yyyy-MM-dd")"
               required />

    </div>

    <button class="btn btn-success">
        Save Notice
    </button>

</form>

            </div>
        </div>

    </div>
</div>