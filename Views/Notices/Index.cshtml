@model List<SocietyManagementSystem.Models.Notice>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 1;
}

<h2 class="mb-4">Notices</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<a href="/Notices/Create"
   class="btn btn-primary mb-3">

    Add Notice

</a>

<form method="get"
      class="mb-4">

    <div class="input-group w-50">

        <input type="text"
               name="search"
               class="form-control"
               placeholder="Search by Notice Title, Category or Description" />

        <button class="btn btn-primary">

            <i class="fas fa-search"></i>

            Search

        </button>

    </div>

    <small class="text-muted">

        Search using:
        Notice Title,
        Category,
        or Description

    </small>

</form>

<table class="table table-bordered table-striped table-hover">

    <thead class="table-dark">

        <tr>
            <th>#</th>
            <th>Title</th>
            <th>Type</th>
            <th>Posted</th>
            <th>Expiry</th>
            <th>Status</th>
            <th width="120">Actions</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var notice in Model)
        {
            <tr>

                <td>@count</td>

                <td>@notice.Title</td>

                <td>@notice.NoticeType</td>

                <td>
                    @(notice.PostedDate?.ToString("dd-MM-yyyy"))
                </td>

                <td>
                    @(notice.ExpiryDate?.ToString("dd-MM-yyyy"))
                </td>

                <!-- STATUS -->
                <td>

                    @if (notice.IsActive == true)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Expired
                        </span>
                    }

                </td>

                <!-- ACTION -->
                <td>

                    <a href="/Notices/Delete/@notice.NoticeId"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Delete notice?')">

                        Delete

                    </a>

                </td>

            </tr>

            count++;
        }

    </tbody>

</table>