@model SocietyManagementSystem.Models.Resident

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body">

                <h2 class="mb-4">Edit Resident</h2>

                <form method="post">

                    <input asp-for="ResidentId" hidden />
                    <input asp-for="UserId" hidden />
                    <input asp-for="CreatedAt" hidden />

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label>Flat Number</label>

                            <input asp-for="FlatNumber"
                                   type="number"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Wing</label>

                            <input asp-for="Wing"
                                   pattern="[A-Za-z]"
                                   maxlength="1"
                                   class="form-control text-uppercase"
                                   style="text-transform:uppercase"
                                   oninput="this.value = this.value.toUpperCase()"
                                   required />

                            <small class="text-muted">
                                Example: A / B / C
                            </small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Floor Number</label>

                            <input asp-for="FloorNumber"
                                   type="number"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Owner / Tenant</label>

                            <select asp-for="OwnerOrTenant"
                                    class="form-control"
                                    required>

                                <option value="">
                                    -- Select --
                                </option>

                                <option value="Owner">
                                    Owner
                                </option>

                                <option value="Tenant">
                                    Tenant
                                </option>

                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Family Members</label>

                            <input asp-for="FamilyMembersCount"
                                   type="number"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Vehicle Number</label>

                            <input asp-for="VehicleNumber"
                                   class="form-control"
                                   maxlength="10"
                                   pattern="[A-Z]{2}[0-9]{2}[A-Z]{2}[0-9]{4}"
                                   style="text-transform:uppercase"
                                   required />

                            <small class="text-muted">
                                Example: MH12AB1234
                            </small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Contact Phone</label>

                            <input asp-for="ContactPhone"
                                   type="tel"
                                   pattern="[0-9]{10}"
                                   maxlength="10"
                                   class="form-control"
                                   required />

                            <small class="text-muted">
                                Enter 10 digit mobile number
                            </small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Move In Date</label>

                            <input asp-for="MoveInDate"
                                   type="date"
                                   class="form-control"
                                   required />
                        </div>

                    </div>

                    <button class="btn btn-warning">
                        Update Resident
                    </button>

                </form>
            </div>
        </div>

    </div>
</div>