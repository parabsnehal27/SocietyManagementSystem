@model List<SocietyManagementSystem.Models.Resident>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 1;
}

<div class="d-flex justify-content-between mb-4">

    <a href="/Residents/Create"
       class="btn btn-primary">

        Add Resident

    </a>

    <div>

        <a href="/Residents/ExportPdf"
           class="btn btn-danger">

            Export PDF

        </a>

        <a href="/Residents/ExportExcel"
           class="btn btn-success">

            Export Excel

        </a>

    </div>

</div>

<form method="get" class="mb-4">

    <div class="input-group w-50">

        <input type="text"
               name="search"
               class="form-control"
               placeholder="Search by Flat, Wing, Owner or Phone" />

        <button class="btn btn-primary">

            <i class="fas fa-search"></i>

            Search

        </button>

    </div>

    <small class="text-muted">

        Search using:
        Flat Number,
        Wing,
        Owner/Tenant,
        or Phone Number

    </small>

</form>

<div class="table-responsive">
<table class="table table-bordered table-striped table-hover">

    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Flat</th>
            <th>Wing</th>
            <th>Floor</th>
            <th>Owner/Tenant</th>
            <th>Phone</th>
            <th>Vehicle</th>
            <th>Move In</th>
            <th>Status</th>
            <th width="180">Actions</th>
        </tr>
    </thead>

        <tbody>

            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    // existing rows
                }
            }
            else
            {
                <tr>

                    <td colspan="10"
                        class="text-center text-muted">

                        No records found

                    </td>

                </tr>
            }

        </tbody>

    <tbody>

        @foreach (var resident in Model)
        {
            <tr>

                <td>@count</td>

                <td>@resident.FlatNumber</td>

                <td>@resident.Wing</td>

                <td>@resident.FloorNumber</td>

                <td>@resident.OwnerOrTenant</td>

                <td>@resident.ContactPhone</td>

                <td>@resident.VehicleNumber</td>

                <td>
                    @(resident.MoveInDate?.ToString("dd-MM-yyyy"))
                </td>

                <td>
                    @if (resident.IsApproved == true)
                    {
                        <span class="badge bg-success">
                            Approved
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>

                        <br />

                        
                    }
                </td>

                <td>

                    <a href="/Residents/Edit/@resident.ResidentId"
                       class="btn btn-sm btn-warning">

                        Edit

                    </a>

                    <a href="/Residents/Delete/@resident.ResidentId"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this record?')">

                        Delete

                    </a>

                </td>

            </tr>

            count++;
        }

    </tbody>

</table>
</div>