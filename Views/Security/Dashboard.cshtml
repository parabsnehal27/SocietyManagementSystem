@{
    Layout = "~/Views/Shared/_SecurityLayout.cshtml";
    ViewData["Title"] = "Security Dashboard";
}
<style>
    .dashboard-container {
        width: 100%;
    }

    .hero-section {
        background: linear-gradient(135deg, #0B8F3A, #22C55E);
        border-radius: 20px;
        padding: 28px;
        color: white;
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        overflow: hidden;
        position: relative;
        box-shadow: 0 10px 25px rgba(0, 102, 204, 0.18);
    }

        .hero-section::before {
            content: "";
            position: absolute;
            right: -40px;
            top: -40px;
            width: 220px;
            height: 220px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

        .hero-content h2 {
            font-size: 30px;
            font-weight: 800;
            margin: 0 0 8px;
        }

        .hero-content p {
            font-size: 17px;
            opacity: 0.95;
            line-height: 1.6;
            max-width: 720px;
        }

    .hero-icon {
        position: relative;
        z-index: 2;
        width: 130px;
        height: 130px;
        background: rgba(255,255,255,0.12);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .hero-icon i {
            font-size: 64px;
            color: rgba(255,255,255,0.9);
        }


    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: #FFFFFF;
        border: 1px solid #D1FAE5;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 6px 18px rgba(0, 102, 204, 0.08);
        position:relative;
        overflow:hidden;
        border-top:4px solid #22C55E;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-title {
        font-size: 15px;
        color: #475569;
    }

    .stat-number {
        font-size: 36px;
        font-weight: 700;
        color: #1A1A2E;
        margin-top: 10px;
    }


    .approved {
        color: #16A34A;
    }

    .pending {
        color: #F59E0B;
    }

    .denied {
        color: #DC2626;
    }

    .active {
        color: #0891B2;
    }

    .actions-section {
        margin-top: 40px;
    }

    .actions-title {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
    }

    .action-card {
        background: #FFFFFF;
        border: 1px solid #D1FAE5;
        border-radius: 18px;
        padding: 25px;
        text-decoration: none;
        color: white;
        transition: 0.3s;
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }

        .action-card:hover {
            transform: translateY(-5px);
            border-color: #0F766E;
            text-decoration: none;
        }

    .action-title {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 10px;
        color: #0F766E;
    }

    .action-desc {
        color: #64748B;
    }

    @@media (max-width: 768px) {
        .hero-section {
            padding: 26px;
            border-radius: 22px;
        }

        .hero-content h2 {
            font-size: 30px;
        }

        .hero-content p {
            font-size: 14px;
        }

        .hero-icon {
            display: none;
        }

        .stat-number {
            font-size: 40px;
        }
    }
</style>

<div class="dashboard-container">

    <!-- HERO -->

    <div class="hero-section">

        <div class="hero-content">

            <h2>Welcome Back, Security</h2>

            <p>
                Monitor visitor entries, manage approvals,
                track deliveries, and maintain society security efficiently.
            </p>

        </div>

    </div>

    <div class="stats-grid">
        <div class="stat-card">
            
            <div class="stat-title">Total Visitors Today</div>
            <div class="stat-number" id="totalVisitors">0</div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Pending Approvals</div>
            <div class="stat-number pending" id="pendingVisitors">0</div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Approved Visitors</div>
            <div class="stat-number approved" id="approvedVisitors">0</div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Denied Visitors</div>
            <div class="stat-number denied" id="deniedVisitors">0</div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Currently Inside</div>
            <div class="stat-number active" id="activeVisitors">0</div>
        </div>
    </div>

    <div class="actions-section">
        <div class="actions-title">Quick Actions</div>

        <div class="actions-grid">
            <a href="/Security/AddVisitorEntry" class="action-card">
                <div class="action-title">Add Visitor Entry</div>
                <div class="action-desc">Register new visitor</div>
            </a>

            <a href="/Security/VisitorLogs" class="action-card">
                <div class="action-title">Visitor Logs</div>
                <div class="action-desc">View all visitor records</div>
            </a>

        </div>
    </div>

</div>

<script>
    function loadDashboardStats() {
        fetch('/Security/GetDashboardStats')
            .then(response => response.json())
            .then(data => {
                document.getElementById('totalVisitors').innerText = data.totalVisitors;
                document.getElementById('pendingVisitors').innerText = data.pendingVisitors;
                document.getElementById('approvedVisitors').innerText = data.approvedVisitors;
                document.getElementById('deniedVisitors').innerText = data.deniedVisitors;
                document.getElementById('activeVisitors').innerText = data.activeVisitors;
            });
    }

    loadDashboardStats();

    setInterval(loadDashboardStats, 5000);
</script>