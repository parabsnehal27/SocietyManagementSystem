@model SocietyManagementSystem.ViewModels.SecurityProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_SecurityLayout.cshtml";
}

<div class="profile-container">

    <div class="profile-header">
        <div>
            <h1>My Profile</h1>
        </div>

    </div>

    <div class="profile-grid">

        <div class="profile-card">
            <h3>Personal Information</h3>

            <div class="info-item">
                <label>Full Name</label>
                <span>@Model.FullName</span>
            </div>

            <div class="info-item">
                <label>Email</label>
                <span>@Model.Email</span>
            </div>

            <div class="info-item">
                <label>Phone Number</label>
                <span>@Model.PhoneNumber</span>
            </div>
        </div>

    </div>

    <div class="profile-actions">
        @* <a asp-action="EditProfile"
           asp-controller="Resident"
           class="btn-primary">

            <i class="fas fa-user-edit"></i>
            Edit Profile

        </a> *@

        <a asp-action="ChangePassword"
           asp-controller="Security"
           class="btn-secondary">

            <i class="fas fa-lock"></i>
            Change Password

        </a>
    </div>

</div>

<style>
    .profile-container {
        width: 100%;
    }

    .profile-header {
        background: linear-gradient(135deg,#0B8F3A,#22C55E);
        color: white;
        padding: 24px;
        border-radius: 20px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .profile-header h1 {
            margin: 0;
        }

        .profile-header p {
            margin-top: 8px;
            opacity: .9;
        }

    .status-badge {
        background: rgba(255,255,255,.2);
        padding: 10px 18px;
        border-radius: 999px;
        font-weight: 600;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: repeat(minmax(320px,1fr));
        gap: 20px;
    }

    .profile-card {
        background: white;
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
    }

        .profile-card h3 {
            margin-bottom: 20px;
            color: #0B8F3A;
        }

    .info-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eee;
    }

        .info-item label {
            font-weight: 600;
            color: #64748B;
        }

        .info-item span {
            font-weight: 500;
        }

    .profile-actions {
        margin-top: 24px;
        display: flex;
        gap: 15px;
    }

    .btn-primary,
    .btn-secondary {
        border: none;
        padding: 12px 20px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-primary {
        background: #E2E8F0;
        color: #000;
        text-decoration: none;
    }

    .btn-secondary {
        background: #E2E8F0;
        color: #000;
        text-decoration: none;
    }
</style>