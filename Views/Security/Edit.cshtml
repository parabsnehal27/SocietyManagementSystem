@model SocietyManagementSystem.Models.SecurityGuard

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow-sm">

            <div class="card-body">

                <h2 class="mb-2 fw-bold">
                    Edit Security Guard
                </h2>

                <p class="text-muted mb-4">
                    Update and manage security staff information
                </p>

                <form method="post">

                    <input type="hidden"
                           asp-for="GuardId" />

                    <!-- EMPLOYEE -->
                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label>
                                Employee Name
                            </label>

                            <select asp-for="UserId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Employee --
                                </option>

                                @foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.UserId">

                                        @user.FullName

                                    </option>
                                }

                            </select>

                        </div>

                    </div>

                    <!-- SHIFT -->
                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label>
                                Shift Timing
                            </label>

                            <select asp-for="ShiftTiming"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Shift --
                                </option>

                                <option>
                                    Morning
                                </option>

                                <option>
                                    Afternoon
                                </option>

                                <option>
                                    Night
                                </option>

                            </select>

                        </div>

                    </div>

                    <!-- ADDRESS -->
                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label>
                                Address
                            </label>

                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="3"
                                      required>
                            </textarea>

                        </div>

                    </div>

                    <!-- AADHAAR -->
                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label>
                                Aadhaar Number
                            </label>

                            <input asp-for="AadhaarNumber"
                                   class="form-control"
                                   maxlength="12"
                                   required />

                        </div>

                    </div>

                    <!-- SALARY -->
                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label>
                                Salary
                            </label>

                            <input asp-for="Salary"
                                   class="form-control"
                                   type="number"
                                   required />

                        </div>

                    </div>

                    <!-- BUTTON -->
                    <button type="submit"
                            class="btn btn-success px-4">

                        <i class="fas fa-save me-2"></i>

                        Update Security Guard

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>