@model IEnumerable<SocietyManagementSystem.Models.VisitorEntry>

@{
    ViewData["Title"] = "Visitor Logs";
    Layout = "~/Views/Shared/_SecurityLayout.cshtml";
}

<style>
    /* GRID */

    .visitor-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 18px;
    }

    /* CARD */

    .visitor-card {
        background: white;
        border-radius: 24px;
        padding: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.06);
        border: 1px solid #DCFCE7;
        transition: 0.3s ease;
    }

        .visitor-card:hover {
            transform: translateY(-6px);
        }

    /* TOP */

    .visitor-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

    .visitor-user {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .visitor-avatar {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, #16A34A, #4ADE80);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
    }

    .visitor-user h3 {
        font-size: 18px;
        color: #0F172A;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .visitor-user p {
        color: #64748B;
        font-size: 14px;
    }

    /* STATUS */

    .status-badge {
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .approved {
        background: #DCFCE7;
        color: #15803D;
    }

    .pending {
        background: #FEF3C7;
        color: #D97706;
    }

    .rejected {
        background: #FEE2E2;
        color: #DC2626;
    }

    /* DETAILS */

    .visitor-details {
        display: grid;
        gap: 14px;
    }

    .detail-box {
        background: #F8FAFC;
        border-radius: 16px;
        padding: 10px 12px;
    }

    .detail-label {
        color: #64748B;
        font-size: 12px;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .detail-value {
        color: #0F172A;
        font-size: 14px;
        font-weight: 700;
    }

    .visitor-footer {
        margin-top: 16px;
        display: flex;
        justify-content: flex-end;
    }

    .exit-btn {
        display: inline-block;
        text-decoration: none;
        background: linear-gradient(135deg, #16A34A, #22C55E);
        color: white;
        padding: 8px 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        transition: 0.3s;
    }

        .exit-btn:hover {
            transform: translateY(-2px);
        }

    .exited-badge {
        background: #DCFCE7;
        color: #15803D;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }
    /* EMPTY */

    .empty-state {
        background: white;
        padding: 70px 30px;
        border-radius: 24px;
        text-align: center;
        box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    }

        .empty-state i {
            font-size: 64px;
            color: #22C55E;
            margin-bottom: 18px;
        }

        .empty-state h3 {
            font-size: 28px;
            margin-bottom: 10px;
            color: #0F172A;
        }

        .empty-state p {
            color: #64748B;
            font-size: 16px;
        }

    /* MOBILE */

    @@media(max-width:768px) {
        .visitor-grid {
            grid-template-columns: 1fr;
        }

        .visitor-card {
            padding: 20px;
        }

        .visitor-user h3 {
            font-size: 18px;
        }

        .visitor-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
        }
    }

</style>

@if (Model != null && Model.Any())
{
    <div class="visitor-grid">

        @foreach (var item in Model)
        {
            string statusClass = item.ApprovalStatus switch
            {
                "Approved" => "approved",
                "Rejected" => "rejected",
                _ => "pending"
            };

            <div class="visitor-card">

                <!-- TOP -->

                <div class="visitor-top">

                    <div class="visitor-user">

                        <div class="visitor-avatar">
                            <i class="fas fa-user"></i>
                        </div>

                        <div>
                            <h3>@item.Visitor.VisitorName</h3>
                            <p>@item.Visitor.PhoneNumber</p>
                        </div>

                    </div>

                    <span class="status-badge @statusClass">
                        @item.ApprovalStatus
                    </span>

                </div>

                <!-- DETAILS -->

                <div class="visitor-details">

                    <div class="detail-box">
                        <div class="detail-label">Purpose</div>
                        <div class="detail-value">
                            @item.Visitor.Purpose
                        </div>
                    </div>

                    <div class="detail-box">
                        <div class="detail-label">Flat Number</div>
                        <div class="detail-value">
                            @item.Resident.FlatNumber
                        </div>
                    </div>

                    <div class="detail-box">
                        <div class="detail-label">Entry Time</div>
                        <div class="detail-value">
                            @item.EntryTime.ToString("dd MMM yyyy hh:mm tt")
                        </div>
                    </div>

                    <div class="detail-box">
                        <div class="detail-label">Exit Time</div>
                        <div class="detail-value">

                            @if (item.ApprovalStatus == "Rejected")
                            {
                                <span style="color:#DC2626; font-weight:700;">
                                    Entry Rejected
                                </span>
                            }
                            else if (item.ApprovalStatus == "Pending")
                            {
                                <span style="color:#D97706; font-weight:700;">
                                    Awaiting Approval
                                </span>
                            }
                            else if (item.ExitTime.HasValue)
                            {
                                @item.ExitTime.Value.ToString("dd MMM yyyy hh:mm tt")
                            }
                            else
                            {
                                <span style="color:#16A34A; font-weight:700;">
                                    Inside Society
                                </span>
                            }

                        </div>
                    </div>

                </div>

                <div class="visitor-footer">

                    @if (item.ApprovalStatus == "Approved" && !item.ExitTime.HasValue)
                    {
                        <a href="/Security/MarkExit/@item.EntryId"
                           class="exit-btn">

                            Mark Exit

                        </a>
                    }
                    else if (item.ExitTime.HasValue)
                    {
                        <span class="exited-badge">
                            Exited
                        </span>
                    }

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="empty-state">

        <i class="fas fa-clipboard-list"></i>

        <h3>No Visitor Logs Found</h3>

        <p>
            Visitor activity will appear here once entries are added.
        </p>

    </div>
}